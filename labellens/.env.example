# Template of required environment variables. Copy to .env.local and fill in. NEVER commit real values.
# Public Supabase URL and anon key (safe for the browser; protected by row-level security).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role key: SERVER ONLY. Used by API routes after authorization and by the seed script. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Demo account passwords used by `npm run seed` (choose your own).
SEED_CUSTOMER_PASSWORD=change-me-customer
SEED_MANUFACTURER_PASSWORD=change-me-manufacturer
# Gemini Vision API Key for packaging OCR and intelligence
GEMINI_API_KEY=